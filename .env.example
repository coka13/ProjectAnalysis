# Optional settings for ProjectAnalysis.
# Copy to ".env" next to this file. Everything here has a working default -
# the application runs with no configuration at all.
# The AAI_ prefix is kept for backwards compatibility with existing .env files.

# --- Window ---
AAI_WINDOW_WIDTH=1400
AAI_WINDOW_HEIGHT=900
# Enables the developer tools inside the desktop window.
AAI_DEBUG=false

# --- Storage ---
# Defaults to %LOCALAPPDATA%\ProjectAnalysis on Windows,
# ~/Library/Application Support/ProjectAnalysis on macOS and
# $XDG_DATA_HOME/ProjectAnalysis on Linux. A folder left over from the previous
# product name is moved across automatically on first run.
AAI_DATA_DIR=
AAI_DATABASE_URL=
# Fernet key used to encrypt the stored AI credential. If empty, a key file is
# generated automatically inside the data directory with restricted permissions.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AAI_SECRET_KEY=

# --- Codebase ingestion ---
# Comma separated allow-list of folders that may be analysed.
# Leave empty to allow any readable folder on this computer.
AAI_ALLOWED_LOCAL_ROOTS=
AAI_ALLOW_REMOTE_CLONE=true
AAI_MAX_FILE_BYTES=1500000
AAI_MAX_FILES=25000
AAI_GIT_TIMEOUT_SECONDS=600

# --- AI provider (optional, any OpenAI-compatible endpoint) ---
# Usually configured from the app's "AI provider" screen instead.
# Without a provider the app falls back to deterministic static analysis.
AAI_AI_BASE_URL=
AAI_AI_MODEL=
AAI_AI_API_KEY=
AAI_AI_TEMPERATURE=0.2
AAI_AI_MAX_TOKENS=2048
AAI_AI_TIMEOUT_SECONDS=120
AAI_AI_MAX_RETRIES=3
AAI_AI_STREAMING=true

# --- Runtime ---
AAI_WORKER_THREADS=2
AAI_HISTORY_MAX_COMMITS=1500
